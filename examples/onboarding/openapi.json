  },
  "tags": [
    {
      "name": "onboarding",
      "description": "Onboarding lifecycle"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      }
    },
    "schemas": {
      "page": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/onboarding"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "items"
        ]
      },
      "problem": {
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ]
      },
      "onboarding": {
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "examples": [
              "onb_4f9x"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "owner": {
            "type": "string",
            "format": "email"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "owner",
          "stage"
        ]
      },
      "upsertRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "format": "email"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "owner",
          "stage"
        ]
      },
      "validationError": {
        "properties": {
          "problems": {
            "items": {
              "$ref": "#/components/schemas/fieldProblem"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "problems"
        ]
      },
      "webhook": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/webhookVariant1"
          },
          {
            "$ref": "#/components/schemas/webhookVariant2"
          }
        ],
        "discriminator": {
          "mapping": {
            "email": "#/components/schemas/webhookVariant1",
            "slack": "#/components/schemas/webhookVariant2"
          },
          "propertyName": "kind"
        }
      },
      "emailWebhook": {
        "properties": {
          "address": {
            "type": "string",
            "format": "email"
          }
        },
        "type": "object",
        "required": [
          "address"
        ]
      },
      "slackWebhook": {
        "properties": {
          "channel": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "channel"
        ]
      },
      "fieldProblem": {
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ]
      },
      "webhookVariant1": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "email",
            "description": "Discriminator"
          },
          "data": {
            "$ref": "#/components/schemas/emailWebhook"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ]
      },
      "webhookVariant2": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "slack",
            "description": "Discriminator"
          },
          "data": {
            "$ref": "#/components/schemas/slackWebhook"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ]
      }
    }
  }
}

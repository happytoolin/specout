      "ChannelConfigVariant1": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "notify_email",
            "description": "Discriminator"
          },
          "data": {
            "$ref": "#/components/schemas/EmailChannel"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ]
      },
      "ChannelConfigVariant2": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "notify_slack",
            "description": "Discriminator"
          },
          "data": {
            "$ref": "#/components/schemas/SlackChannel"
          }
        },
        "type": "object",
        "required": [

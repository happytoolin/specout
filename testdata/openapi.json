  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKey": []
    },
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      },
      "session": {
        "type": "apiKey",
        "name": "session",
        "in": "cookie"
      }
    },
    "schemas": {
      "Problem": {
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "Onboarding": {
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "examples": [
              "onb_4f9x"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "owner": {
            "type": "string",
            "format": "email"
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "expiry": {
            "format": "date-time",
            "description": "Optional expiry",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "owner",
          "stage"
        ]
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Onboarding"
            },
            "type": "array"
          },
          "next": {
            "type": "string",
            "description": "Cursor for the next page"
          }
        },
        "type": "object",
        "required": [
          "items"
        ]
      },
      "ImportRequest": {
        "properties": {
          "File": {
            "type": "string",
            "format": "binary",
            "description": "CSV of onboarding records"
          },
          "Mode": {
            "type": "string",
            "enum": [
              "merge",
              "replace"
            ],
            "default": "merge"
          }
        },
        "type": "object",
        "required": [
          "File",
          "Mode"
        ]
      },
      "UpsertRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "format": "email"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "owner",
          "stage"
        ]
      },
      "SyncRequest": {

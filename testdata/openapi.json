  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKey": []
    },
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "name": "X-API-Key",
        "in": "header"
      },
      "session": {
        "type": "apiKey",
        "name": "session",
        "in": "cookie"
      }
    },
    "schemas": {
      "UpsertRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "format": "email"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "owner",
          "stage"
        ]
      },
      "Onboarding": {
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "examples": [
              "onb_4f9x"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "owner": {
            "type": "string",
            "format": "email"
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "expiry": {
            "format": "date-time",
            "description": "Optional expiry",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "owner",
          "stage"
        ]
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "ValidationError": {
        "properties": {
          "problems": {
            "items": {
              "$ref": "#/components/schemas/FieldProblem"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "problems"
        ]
      },
      "SyncRequest": {
        "properties": {
          "expected": {
            "type": "integer",
            "description": "Client's last seen version"
          }
        },
        "type": "object",
        "required": [
          "expected"
        ]
      },
      "SyncResult": {
        "properties": {
          "count": {
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "count"
        ]
      },
      "SyncConflict": {
        "properties": {
          "resource": {
            "type": "string",
            "examples": [
              "onboarding"
            ]
          },
          "expected": {
            "type": "integer",
            "description": "Version the client sent"
          },
          "actual": {
            "type": "integer",
            "description": "Version currently on the server"
          },
          "resolveUrl": {
            "type": "string",
            "description": "Fetch the current state here"
          }
        },
        "type": "object",
        "required": [
          "resource",
          "expected",
          "actual",
          "resolveUrl"
        ]
      },
      "ImportRequest": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "CSV of onboarding records"
          },
          "mode": {
            "type": "string",
            "enum": [
              "merge",
              "replace"
            ],
            "default": "merge"
          }
        },
        "type": "object",
        "required": [
          "file",
          "mode"
        ]
      },
      "Config": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ConfigVariant1"
          },
          {
            "$ref": "#/components/schemas/ConfigVariant2"
          }
        ],
        "discriminator": {
          "mapping": {
            "email": "#/components/schemas/ConfigVariant1",
            "slack": "#/components/schemas/ConfigVariant2"
          },
          "propertyName": "kind"
        }
      },
      "EmailConfig": {
        "properties": {
          "address": {
            "type": "string",
            "format": "email"
          }
        },
        "type": "object",
        "required": [
          "address"
        ]
      },
      "SlackConfig": {
        "properties": {
          "channel": {
            "type": "string"
          },
          "events": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "channel"
        ]
      },
      "CreateThingRequest": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9-]*$",
            "examples": [
              "acme-thing"
            ]
          },
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "examples": [
              "ops@example.com"
            ]
          },
          "site": {
            "type": "string",
            "format": "uri"
          },
          "priority": {
            "type": "integer",
            "maximum": 5,
            "minimum": 1,
            "default": 3
          },
          "weight": {
            "type": "number",
            "multipleOf": 0.5,
            "maximum": 1000,
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "maximum": 1000000,
            "minimum": 0
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "uniqueItems": true,
            "description": "Free-form labels"
          },
          "scores": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "description": "Judges scores 0-10"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "private"
            ],
            "default": "public"
          },
          "expiresAt": {
            "format": "date-time",
            "description": "Null or omit for never",
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "description": "Arbitrary string labels"
          },
          "limits": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "description": "Per-region limits"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "displayName",
          "email",
          "priority",
          "stock",
          "tags",
          "visibility"
        ]
      },
      "Thing": {
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "examples": [
              "thg_01HX"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "priority": {
            "type": "integer",
            "maximum": 5,
            "minimum": 1
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "uniqueItems": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "private"
            ]
          },
          "expiresAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "slug",
          "email",
          "priority",
          "tags",
          "visibility"
        ]
      },
      "ChannelConfig": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChannelConfigVariant1"
          },
          {
            "$ref": "#/components/schemas/ChannelConfigVariant2"
          }
        ],
        "discriminator": {
          "mapping": {
            "notify_email": "#/components/schemas/ChannelConfigVariant1",
            "notify_slack": "#/components/schemas/ChannelConfigVariant2"
          },
          "propertyName": "kind"
        }
      },
      "EmailChannel": {
        "properties": {
          "address": {
            "type": "string",
            "format": "email"
          }
        },
        "type": "object",
        "required": [
          "address"
        ]
      },
      "SlackChannel": {
        "properties": {
          "webhook": {
            "type": "string",
            "format": "uri"
          },
          "channel": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "webhook",
          "channel"
        ]
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Onboarding"
            },
            "type": "array"
          },
          "next": {
            "type": "string",
            "description": "Cursor for the next page"
          }
        },
        "type": "object",
        "required": [
          "items"
        ]
      },
      "ThingList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Thing"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "items"
        ]
      },
      "FieldProblem": {
        "properties": {
          "field": {
            "type": "string",
            "examples": [
              "owner"
            ]
          },
          "message": {
            "type": "string",
            "examples": [
              "must be a valid email"
            ]
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ]
      },
      "ConfigVariant1": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "email",
            "description": "Discriminator"
          },
          "data": {
            "$ref": "#/components/schemas/EmailConfig"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "data"
        ]
      },
      "ConfigVariant2": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "slack",
            "description": "Discriminator"
          },
          "data": {

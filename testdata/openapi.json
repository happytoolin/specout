          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "OnboardingList": {
        "items": {
          "properties": {
            "id": {
              "type": "string"
            },
            "owner": {
              "type": "string",
              "format": "email"
            },
            "stage": {
              "type": "string",
              "enum": [

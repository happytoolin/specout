    "/onboarding": {
      "get": {
        "summary": "List onboarding records",
        "operationId": "getOnboarding",
        "security": [],
        "tags": [
          "onboarding"
        ],
        "parameters": [
          {
            "name": "session",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Session cookie from login"
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20

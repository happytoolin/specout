  "components": {
    "schemas": {
      "Problem": {
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "Onboarding": {
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "examples": [
              "onb_4f9x"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "owner": {
            "type": "string",
            "format": "email"
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "expiry": {
            "format": "date-time",
            "description": "Optional expiry",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "owner",
          "stage"
        ]
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "type": "string",
                  "examples": [
                    "onb_4f9x"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "owner": {
                  "type": "string",
                  "format": "email"
                },
                "apiKey": {
                  "type": "string"
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "active",
                    "archived"
                  ],
                  "default": "draft"
                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                },
                "expiry": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Optional expiry"
                }
              },
              "type": "object",
              "required": [
                "id",
                "createdAt",
                "owner",
                "stage"
              ]
            },
            "type": "array"
          },
          "next": {
            "type": "string",
            "description": "Cursor for next page"
          }
        },
        "type": "object",
        "required": [
          "items"
        ]
      },
      "UpsertRequest": {
        "properties": {
          "owner": {
            "type": "string",
            "format": "email"
          },
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ],
            "default": "draft"
          }
        },
        "type": "object",
        "required": [
          "owner",
          "stage"
        ]
      },
      "ImportRequest": {
        "properties": {
          "File": {
            "properties": {},
            "type": "object",
            "description": "CSV of onboardings"
          },
          "Mode": {
            "type": "string",
            "enum": [
              "merge",
              "replace"
            ],
            "default": "merge"
          }
        },
        "type": "object",
        "required": [
          "File",
          "Mode"
        ]
      },
      "SyncResult": {
        "properties": {
          "count": {
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "count"
        ]
      },
      "SyncConflict": {
        "properties": {
          "resource": {
            "type": "string",
            "examples": [
              "onboarding"
            ]
          },
          "expected": {
            "type": "integer"
          },
          "actual": {
            "type": "integer"
          },
          "resolveUrl": {
            "type": "string",
            "description": "Fetch current state here"
          }
        },
        "type": "object",
        "required": [
          "resource",
          "expected",
          "actual",
          "resolveUrl"
        ]
      },
      "ValidationError": {
        "properties": {
          "problems": {
            "items": {
              "properties": {
                "field": {
                  "type": "string",
                  "examples": [
                    "owner"
                  ]
                },
